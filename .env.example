# --- Backend & Database (Neon PostgreSQL) ---
NODE_ENV=development
PORT=4000

# Pooled connection string for runtime queries
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/triagesync?sslmode=require

# Direct connection string for Drizzle migrations
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/triagesync?sslmode=require

# Dedicated Neon branch/database for integration & concurrency tests
TEST_DATABASE_URL=postgresql://user:password@ep-example-test-pooler.us-east-2.aws.neon.tech/triagesync_test?sslmode=require

# --- Auth & CORS ---
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_PASSWORD=Admin@123

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000